DATABASE_URL="mysql://user:password@localhost:3306/osint_tool"

# Signs the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=""

# Read once by `npm run db:seed` to create the first account.
# Safe to remove from .env after the account exists.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
