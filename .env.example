DATABASE_URL="mysql://user:password@localhost:3306/osint_tool"

# Signs the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value on every machine. Changing it signs everyone out.
SESSION_SECRET=""

# The account `npm run db:seed` creates. Leave blank to use the defaults
# documented in the README — change the password once you are signed in.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Base URL used to build absolute links in outgoing emails (verification, share invites).
# Public origin of this deployment. Used for the links in outgoing email *and*
# for canonical URLs, OG images and the sitemap — a wrong value here points
# Google at the wrong host.
APP_URL="http://localhost:3000"

# SMTP settings for outgoing mail (registration verification, share invites).
# Leave MAIL_HOST blank to run without email — the app logs a warning and
# skips sending instead of failing.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.ferdyhape.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME=""
