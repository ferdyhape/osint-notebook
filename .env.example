DATABASE_URL="mysql://user:password@localhost:3306/osint_tool"

# Signs the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value on every machine. Changing it signs everyone out.
SESSION_SECRET=""

# The account `npm run db:seed` creates. Leave blank to use the defaults
# documented in the README — change the password once you are signed in.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
