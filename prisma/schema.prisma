generator client {
  provider = "prisma-client-js"
  // "native" builds for this machine; the Linux target is what the Ubuntu 22
  // server needs, so a node_modules built on Windows still runs there.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Case {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  description String?  @db.Text
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  entities      Entity[]
  relationships Relationship[]
  notes         Note[]
  shares        CaseShare[]

  @@index([userId])
}

model Entity {
  id         Int      @id @default(autoincrement())
  caseId     Int
  type       String
  value      String
  attributes Json?
  source     String?
  positionX  Float?
  positionY  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  notes           Note[]
  relationshipsA  Relationship[] @relation("EntityA")
  relationshipsB  Relationship[] @relation("EntityB")

  @@index([caseId])
  @@index([type])
}

model Relationship {
  id           Int      @id @default(autoincrement())
  caseId       Int
  entityAId    Int
  entityBId    Int
  relationType String
  notes        String?  @db.Text
  /// Perpendicular offset (px) of the curve's control point from the straight
  /// line between the two entities — lets a user bend a line manually so it
  /// clears an overlapping node instead of always taking React Flow's default arc.
  bendOffset   Float    @default(0)
  createdAt    DateTime @default(now())

  case    Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entityA Entity @relation("EntityA", fields: [entityAId], references: [id], onDelete: Cascade)
  entityB Entity @relation("EntityB", fields: [entityBId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([entityAId])
  @@index([entityBId])
}

model Note {
  id        Int      @id @default(autoincrement())
  caseId    Int
  entityId  Int?
  content   String   @db.Text
  createdAt DateTime @default(now())

  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entity Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([entityId])
}

model PivotRule {
  id          Int      @id @default(autoincrement())
  entityType  String
  title       String
  description String   @db.Text
  actionType  String
  urlTemplate String?
  category    String
  isFree      Boolean  @default(true)
  combinable  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType])
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String?
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cases              Case[]
  createdShares      CaseShare[]         @relation("CaseShareCreatedBy")
  shareGrants        CaseShare[]         @relation("CaseShareUser")
  verificationTokens VerificationToken[]
}

/// Email-based shares (identity-gated, viewer|editor) AND the case's single
/// public link (anonymous, always viewer). `kind` discriminates the two.
model CaseShare {
  id           Int      @id @default(autoincrement())
  caseId       Int
  kind         String // "email" | "link"
  role         String   @default("viewer") // "viewer" | "editor" — link rows are always "viewer"
  invitedEmail String? // kind="email" only, lowercased/trimmed
  userId       Int? // resolved once the invitee signs in with a matching email
  linkToken    String?  @unique // kind="link" only
  createdById  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  case      Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User? @relation("CaseShareUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User  @relation("CaseShareCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([caseId, invitedEmail])
  @@index([caseId])
  @@index([userId])
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  purpose   String // "email_verify"
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
